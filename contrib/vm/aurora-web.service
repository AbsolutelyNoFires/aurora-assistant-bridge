[Unit]
Description=Aurora 4X VNC websocket (websockify on 127.0.0.1:6080, proxied by the companion bridge)
After=network-online.target tigervncserver@:1.service
Wants=network-online.target

[Service]
User=aurora4x
ExecStart=/usr/bin/websockify 127.0.0.1:6080 127.0.0.1:5901
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
