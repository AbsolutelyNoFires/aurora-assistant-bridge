[Unit]
Description=Aurora Assistant bridge (web chat with the game desktop, journal, assistant loop)
After=network-online.target aurora-web.service
Wants=network-online.target

[Service]
User=aurora4x
ExecStart=/home/aurora4x/aurora-assistant-bridge/.venv/bin/aurora-assistant
AmbientCapabilities=CAP_NET_BIND_SERVICE
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
