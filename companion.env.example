# Copy to ~/.config/aurora-companion/companion.env and restart: sudo systemctl restart aurora-companion

# OpenAI-compatible endpoint of the local model server (llama.cpp, vLLM, Ollama, LM Studio...).
# Either the server root or its /v1 path works.
LLM_BASE_URL=
LLM_MODEL=local
LLM_API_KEY=
LLM_TEMPERATURE=0.4
# native = OpenAI tool calling; text = JSON action blocks in the reply (for models with poor tool calling)
TOOL_MODE=native

# Context budgets in characters (~4 chars per token); chat and journal are truncated separately.
CHAT_BUDGET_CHARS=24000
JOURNAL_BUDGET_CHARS=12000
MAX_TOOL_STEPS=25

# Background wake-ups (0 disables): after N new journal entries, or N minutes with new activity.
WAKE_JOURNAL_ENTRIES=15
WAKE_MINUTES=10
